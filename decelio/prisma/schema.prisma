generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Authentification (NextAuth v5 + @auth/prisma-adapter)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  passwordHash  String?
  emailVerified DateTime?
  image         String?

  plan                   String    @default("FREE")
  stripeCustomerId       String?   @unique
  stripeSubscriptionId   String?   @unique
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?

  // Cycle de vie RGPD : la purge est calculable, pas implicite.
  cancelledAt    DateTime?
  purgeAt        DateTime?
  dataExportedAt DateTime?

  // Essai gratuit de 14 jours : un seul essai par compte. `trialUsedAt` est
  // posé dès le premier abonnement (essai ou paiement immédiat) et n'est
  // jamais effacé, même après résiliation. `stripeTrialEnd` reflète la date
  // de fin d'essai en cours ; il est remis à `null` à la conversion (premier
  // paiement réussi), ce qui sert aussi de marqueur anti-double-comptage pour
  // l'événement `trial_converted`.
  trialUsedAt    DateTime?
  stripeTrialEnd DateTime?

  // Offre fondatrice : -50 % à vie pour les 10 premières agences.
  isFounderMember Boolean   @default(false)
  founderOfferAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  accounts       Account[]
  sessions       Session[]
  sites          Site[]
  monitoredSites MonitoredSite[]
  clients        Client[]
  brandSettings  BrandSettings?

  @@index([purgeAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Domaine métier (V3 - Scanner et Pré-rendu)
// ---------------------------------------------------------------------------

model Site {
  id        String   @id @default(cuid())
  userId    String
  name      String
  domain    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  pages Page[]

  @@unique([id, userId])
  @@index([userId])
}

model Page {
  id        String   @id @default(cuid())
  siteId    String
  url       String
  path      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  site     Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  botScans BotScan[]

  @@unique([siteId, path])
  @@index([siteId])
}

model BotScan {
  id        String    @id @default(cuid())
  pageId    String
  botName   String
  userAgent String
  status    String    @default("PENDING")
  scannedAt DateTime?
  createdAt DateTime  @default(now())

  page       Page        @relation(fields: [pageId], references: [id], onDelete: Cascade)
  scanResult ScanResult?

  @@index([pageId])
}

model ScanResult {
  id          String   @id @default(cuid())
  botScanId   String   @unique
  statusCode  Int
  hasJsError  Boolean  @default(false)
  isHtmlEmpty Boolean  @default(false)
  rawHtml     String?
  createdAt   DateTime @default(now())

  botScan BotScan @relation(fields: [botScanId], references: [id], onDelete: Cascade)
}

/// Limitation de débit à fenêtre fixe. La base est la seule ressource
/// partagée entre instances en exécution sans serveur.
model RateLimit {
  id     String   @id @default(cuid())
  key    String
  window DateTime
  count  Int      @default(1)

  @@unique([key, window])
  @@index([window])
}

model AuditLead {
  id        String   @id @default(cuid())
  email     String
  domain    String
  // brandName a été retiré : captureLead (app/actions/lead.ts) ne collecte
  // plus de champ de citation/marque (docs/08-constitution.md — Decelio ne
  // mesure pas les citations). Rendu optionnel plutôt que supprimé pour ne
  // pas perdre les valeurs déjà en base.
  brandName String?
  score     Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([email, domain])
  @@index([createdAt])
}

model ProcessedWebhook {
  id          String   @id
  processedAt DateTime @default(now())
}

model MonitoredSite {
  id        String   @id @default(cuid())
  userId    String
  name      String
  url       String
  status    String   @default("ACTIVE")
  clientId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  client      Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  scanLogs    ScanLog[]
  alertEvents AlertEvent[]

  @@unique([userId, url])
  @@index([userId])
  @@index([clientId])
  @@index([status, createdAt])
}

model ScanLog {
  id           String   @id @default(cuid())
  siteId       String
  httpStatus   Int
  payload      String?
  /// Verdict simplifié dérivé du CoreScanOutput (OK, BLOQUÉ, COQUILLE VIDE, ERREUR).
  simpleStatus String?
  /// Cause lisible du verdict, en français.
  cause        String?
  createdAt    DateTime @default(now())

  site MonitoredSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, createdAt(sort: Desc)])
}

/// Client final d'une agence : regroupe des sites pour le rapport en marque blanche.
model Client {
  id        String   @id @default(cuid())
  userId    String
  name      String
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sites   MonitoredSite[]
  reports MonthlyReport[]

  @@index([userId])
}

/// Réglages de marque blanche de l'agence (1-1 avec User).
model BrandSettings {
  id          String   @id @default(cuid())
  userId      String   @unique
  agencyName  String?
  logoUrl     String?
  accentColor String?
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Alerte envoyée lors d'un changement d'état d'un site (une par changement).
model AlertEvent {
  id      String   @id @default(cuid())
  siteId  String
  /// REGRESSION ou RESOLUTION.
  type    String
  cause   String
  fix     String?
  /// EMAIL (Slack et webhook en préparation).
  channel String   @default("EMAIL")
  sentAt  DateTime @default(now())

  site MonitoredSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, sentAt(sort: Desc)])
}

/// Rapport mensuel en marque blanche, par client et par période (AAAA-MM).
model MonthlyReport {
  id              String   @id @default(cuid())
  clientId        String
  period          String
  pdf             Bytes?
  availabilityPct Float?
  incidentCount   Int      @default(0)
  generatedAt     DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, period])
}

/// Vue de page marketing (compteur minimaliste sans cookie, RGPD-safe).
model PageView {
  id        String   @id @default(cuid())
  path      String
  referrer  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([path, createdAt(sort: Desc)])
}
