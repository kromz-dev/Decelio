# Required at runtime
DATABASE_URL="postgresql://user:password@localhost:5432/decelio"
# Direct (non-pooled) connection, required by Prisma Migrate. In production this is
# the Neon connection string WITHOUT the "-pooler" suffix (see docs/runbooks/deploiement-render-neon.md).
# In local dev and CI it can be the same value as DATABASE_URL.
DIRECT_URL="postgresql://user:password@localhost:5432/decelio"
AUTH_SECRET="replace-with-at-least-32-random-characters"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Nécessaire en local (localhost) et derrière le proxy inverse de Render : sans
# elle, Auth.js v5 rejette la requête (MissingAuthTrustHost) car il ne fait pas
# confiance par défaut à l'en-tête "host" transmis par un proxy.
AUTH_TRUST_HOST=true
# Credentials auth uses the database and AUTH_SECRET; no password-specific secret is required.
# Registration is limited to 5 attempts per IP and fixed hour in the shared database (not process memory).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional. Number of trusted reverse proxies in front of the app, used by lib/rate-limit.ts
# to pick the right IP from x-forwarded-for (counted from the right). On Render there is
# exactly one proxy, so the default of 1 is correct there — leave unset.
# TRUSTED_PROXY_HOPS="1"

# Optional PostHog browser analytics
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN="your-posthog-project-token"
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"

# Required for the signed Inngest endpoint in production
INNGEST_SIGNING_KEY=""
# Required in production so the app can send events to Inngest Cloud
INNGEST_EVENT_KEY=""

# Required for paid billing operations
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_SOLO=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_SCALE=""
# Id du coupon natif Stripe (pas un code promo) accepté par createCheckoutSession
STRIPE_FOUNDER_COUPON="FONDATEUR50"

# Required when sending audit report emails
RESEND_API_KEY=""
# Optional. Expediteur de repli pour tous les e-mails Resend (alertes et
# transactionnels). A laisser VIDE en production : bonjour@decelio.fr reste
# l'expediteur une fois son domaine verifie chez Resend. En local, mettre
# "Decelio <onboarding@resend.dev>" : cet expediteur fonctionne sans domaine
# verifie, mais n'ecrit qu'au propriétaire du compte Resend (T092).
ALERT_FROM_EMAIL=""

# Required for the measurement engines used by audits
GEMINI_API_KEY=""
GROQ_API_KEY=""
GEMINI_BILLING_TIER="free"

# Optional cache hardening
ENGINE_CACHE_SECRET=""
