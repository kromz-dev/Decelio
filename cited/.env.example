# Required at runtime
DATABASE_URL="postgresql://user:password@localhost:5432/cited"
AUTH_SECRET="replace-with-at-least-32-random-characters"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Credentials auth uses the database and AUTH_SECRET; no password-specific secret is required.
# Registration is limited to 5 attempts per IP and fixed hour in the shared database (not process memory).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional PostHog browser analytics
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN="your-posthog-project-token"
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"

# Required for the signed Inngest endpoint in production
INNGEST_SIGNING_KEY=""

# Required for paid billing operations
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_SOLO=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_SCALE=""
# Id du coupon natif Stripe (pas un code promo) accepté par createCheckoutSession
STRIPE_FOUNDER_COUPON="FONDATEUR50"

# Required when sending audit report emails
RESEND_API_KEY=""

# Required for the measurement engines used by audits
GEMINI_API_KEY=""
GROQ_API_KEY=""
GEMINI_BILLING_TIER="free"

# Optional cache hardening
ENGINE_CACHE_SECRET=""
